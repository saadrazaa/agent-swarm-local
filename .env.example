# Copy to .env via scripts/bootstrap.sh (never edit .env secrets by hand except
# the user-supplied provider credentials at the bottom). .env is git-ignored and
# must be mode 600. Store a recovery copy of .env AND ./encryption_key in an
# encrypted password manager / off-device backup. Losing encryption_key makes
# every encrypted secret in swarm_api_data unrecoverable.
#
# These are the interpolation variables consumed by compose.yaml. The
# encryption key itself lives in the separate ./encryption_key file (mounted as
# a Compose secret), NOT here.

# --- Generated by bootstrap.sh (permanent identity; never regenerate) ---------
# API operator key (openssl rand -hex 32)
API_KEY=

# MinIO root credentials (random, never minioadmin/minioadmin)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Host loopback port that publishes MinIO's S3 API (container port 9000).
# NOTE: default is 9002, not 9000 — port 9000 is already taken on this host by
# the client-monorepo dev stack. Signed object URLs will use this port. If you
# free port 9000, you may set this back to 9000.
MINIO_HOST_PORT=9002

# Stable agent identities (uuidgen). These map 1:1 to personal volumes and are
# permanent. Regenerating any of them orphans that agent's memory/identity.
LEAD_AGENT_ID=
CLAUDE_WORKER_AGENT_ID=
CODEX_WORKER_AGENT_ID=

# --- Supplied by the user (paste real values, then re-run bootstrap or edit) --
# Claude API key used by the lead and the Claude coder worker.
ANTHROPIC_API_KEY=
# Codex/OpenAI API key used only by the Codex coder worker.
OPENAI_API_KEY=
# Fine-grained GitHub PAT, restricted to an explicit repo allowlist, with
# contents + pull-requests read/write (issues r/w optional). Workers only.
GITHUB_WORKER_TOKEN=
# Commit identity for agent-created branches.
GITHUB_EMAIL=
GITHUB_NAME=
