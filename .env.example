# Reference for the .env that scripts/bootstrap.sh generates. Do not copy this
# file by hand — run `./scripts/bootstrap.sh`, then paste your provider
# credentials into the generated .env.
#
# .env is git-ignored and must be mode 600. Store a recovery copy of .env AND
# ./encryption_key in an encrypted password manager / off-device backup. Losing
# encryption_key makes every encrypted secret in swarm_api_data unrecoverable.
#
# This file lists exactly the interpolation variables compose.yaml consumes.
# Image pins live in versions.env; the secrets-encryption key lives in the
# separate ./encryption_key file (mounted as a Compose secret), not here.

# --- Generated by bootstrap.sh (permanent identity; never regenerate) ---------
# API operator key (openssl rand -hex 32)
API_KEY=

# MinIO root credentials (random, never minioadmin/minioadmin)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Host loopback port that publishes MinIO's S3 API (container port 9000).
# Defaults to 9002 rather than 9000 so it does not collide with another local
# MinIO or S3-compatible service. Signed object URLs use this port. If 9000 is
# free on your host you may set it to 9000.
MINIO_HOST_PORT=9002

# Stable agent identities (uuidgen), one per agent service. These map 1:1 to the
# agents' personal volumes and are permanent — regenerating any of them orphans
# that agent's memory and identity. Mapping:
#   LEAD_AGENT_ID          -> tars     (lead, Claude)
#   CLAUDE_WORKER_AGENT_ID -> chase    (coder, Claude)
#   CODEX_WORKER_AGENT_ID  -> rocky    (coder, Codex)
#   RESEARCHER_AGENT_ID    -> einstein (researcher, Claude)
LEAD_AGENT_ID=
CLAUDE_WORKER_AGENT_ID=
CODEX_WORKER_AGENT_ID=
RESEARCHER_AGENT_ID=

# agent-fs human "viewer" identity. agent-fs is multi-tenant and the swarm's own
# keys are server-generated + encrypted, so this is the ONE key you can use to
# browse all agent memory in the live viewer (https://live.agent-fs.dev). Format
# af_<64 hex>; generated by bootstrap.sh. The agent-fs-viewer-init service seeds
# it and grants it access on every `up`. Permanent — vault it like the keys above.
AGENT_FS_VIEWER_KEY=
AGENT_FS_VIEWER_EMAIL=viewer@local

# --- Supplied by you (paste real values into .env) ----------------------------
# Claude auth for the lead, the Claude coder, and the researcher. Set EXACTLY ONE:
#   ANTHROPIC_API_KEY       — Anthropic API key (sk-ant-api…), pay-per-token API billing
#   CLAUDE_CODE_OAUTH_TOKEN — Claude Code OAuth token (sk-ant-oat…), Claude subscription quota
# (An OAuth token pasted into ANTHROPIC_API_KEY fails with 401 invalid x-api-key.)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI API key, used by the Codex coder worker (rocky) AND by the API for
# memory embeddings (compose passes it to the api service as EMBEDDING_API_KEY).
# Without it, semantic memory-search silently degrades to keyword-only FTS
# (GET /api/memory/health reports retrievalMode "fallback").
OPENAI_API_KEY=

# --- Optional -----------------------------------------------------------------
# Where the browser dashboard lives. The API uses it to build outbound links
# (e.g. HITL approval URLs) and agents use it to build share links
# (${APP_URL}/pages/:id). Unset defaults to the hosted UI
# (https://app.agent-swarm.dev); set this if you run the UI locally instead.
# APP_URL=http://127.0.0.1:5274

# Bare dashboard host (no scheme) agents use in plain copy. Keep it in sync
# with APP_URL when you override that. Unset defaults to app.agent-swarm.dev.
# SWARM_URL=127.0.0.1:5274

# agent-fs live viewer origin agents use for file share links
# (${AGENT_FS_LIVE_URL}/file/~/<org>/<drive>/<path>). Unset defaults to the
# hosted viewer, which matches AGENT_FS_APP_URL in compose.yaml.
# AGENT_FS_LIVE_URL=https://live.agent-fs.dev

# NOTE: Git/GitHub credentials are deliberately absent. compose.yaml passes no
# Git or GitHub variables to any service — agent Git identity and tokens are
# configured inside the swarm's own global config (dashboard → Settings), which
# stores them encrypted in swarm_api_data. Do not add them here expecting the
# stack to read them.
